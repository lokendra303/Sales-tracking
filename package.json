{
  "name": "salestrack",
  "private": true,
  "workspaces": [
    "backend",
    "frontend",
    "mobile"
  ],
  "scripts": {
    "backend": "npm run dev --workspace=backend",
    "backend:seed": "npm run db:seed --workspace=backend",
    "frontend": "npm run dev --workspace=frontend",
    "frontend:build": "npm run build --workspace=frontend",
    "mobile": "npm run start --workspace=mobile",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:restart": "pm2 restart ecosystem.config.cjs",
    "pm2:logs": "pm2 logs"
  },
  "devDependencies": {
    "pm2": "^7.0.4"
  }
}
